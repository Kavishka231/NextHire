# NextHire production environment template
# Copy this file to .env on the deployment host. Replace every replace-* value.
# Never commit the resulting .env file.

# Runtime and release identity
ENVIRONMENT=production
APP_RELEASE=replace-with-git-commit-sha
LOG_LEVEL=INFO

# Authentication
# Generate independently, for example: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=nexthire_refresh
REFRESH_COOKIE_SECURE=true
RESET_TOKEN_EXPIRE_MINUTES=30

# Public HTTPS origins (origins only: no paths, query strings, or trailing data)
PUBLIC_APP_URL=https://replace-with-your-app-domain.example
CORS_ORIGINS=https://replace-with-your-app-domain.example
FRONTEND_PORT=5500

# PostgreSQL (URL-encode special characters in the password used in DATABASE_URL)
POSTGRES_USER=nexthire
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=nexthire
DATABASE_URL=postgresql://nexthire:replace-with-url-encoded-database-password@db:5432/nexthire
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Redis/Celery. Use a TLS redis:// provider URL when required by your platform.
REDIS_URL=redis://redis:6379/0

# Abuse protection
AUTH_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5
EMAIL_RATE_LIMIT_PER_HOUR=10

# SMTP. Keep EMAIL_ENABLED=false until sender verification and delivery tests pass.
EMAIL_ENABLED=false
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=noreply@replace-with-your-domain.example
MAIL_FROM_NAME=NextHire
MAIL_SERVER=replace-with-smtp-hostname
MAIL_PORT=587
MAIL_TIMEOUT_SECONDS=10

# Adzuna production API credentials
ADZUNA_APP_ID=replace-with-adzuna-app-id
ADZUNA_APP_KEY=replace-with-adzuna-app-key

# Sentry is disabled when the DSN is empty. Set APP_RELEASE above when enabling it.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Private Prometheus/Grafana observability profile
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
# Host path to a file containing the Alertmanager notification webhook URL.
# ALERT_WEBHOOK_URL_FILE=/absolute/path/to/alert-webhook-url

# One-time administrator bootstrap. Enable for one deployment, then disable it.
SEED_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=NextHire Admin
